{
  "manifest_version": 3,
  "name": "AutoDL 克隆抢机助手",
  "version": "1.3.2",
  "description": "读取当前 AutoDL 克隆页的源实例，检查 GPU、扩容空间和价格；支持仅检查与自动创建。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.autodl.com/cloneInstance*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}

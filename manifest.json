{
  "manifest_version": 3,
  "name": "AutoDL 克隆抢机助手",
  "version": "1.4.0",
  "description": "支持 AutoDL 克隆和租用新服务器页面；按库存筛选 GPU 和 Top 3 主机，新租用保留所选基础镜像。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.autodl.com/cloneInstance*", "https://www.autodl.com/create*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
